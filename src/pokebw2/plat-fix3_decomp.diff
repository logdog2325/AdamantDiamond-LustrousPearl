@@ -32,6 +32,7 @@
 
 #include "types.h"
 #include "struct_decls.h"
+#include "nitro/fx.h"
 #include "follower_port.h"
 
 // 0xfc: Black 2 draws a walking Pokémon (scene node 10/11) of this uid where it stands, without the bob, the lift and
@@ -94,4 +95,20 @@ void Follower_Hide(void);
 void Follower_PairStart(FieldActor *actor, u16 moveCode);
 u32 Follower_SightCollCheck(FieldActor *actor, s16 x, s16 y, s16 z, u16 dir);
 
+// Its picture (as above):
+// - ov036 field_rail_loader.c RailActorAnim_DrawWalking (scene nodes 10 and 11: Black 2's walking Pokémon) and
+//   func_ov036_0219656c (scene node 2: a person's walker, the hack's own sheets): CopyActorPosAllAdd(actor, &pos) ->
+//   Follower_DrawPos(actor, &pos) (the same; the follower on the player's row is drawn behind them, below).
+// Beside the player on their row the follower's billboard is at the player's depth exactly (the field camera looks
+// straight north, so x changes no depth), and the DS's depth test keeps the first of two equal pixels: which one wins
+// goes by the order of their billboard slots, and its picture, wider than a tile, covered the player. Black 2
+// steps its own walking Pokémon 2 units north for this (RailActorAnim_UpdateWalkOffset), which uid 0xfc leaves out (the
+// step also draws the picture 1.8 px higher at camera 0, and 2 units are under one depth step there). Here the
+// follower's billboard goes back along the line from the eye to its place, by two depth steps of the DS's Z-buffer at
+// that distance (d * d / (16384 * near) units, at most 8): its place stays on its pixel and only the depth changes,
+// but for the picture drawn 1.4 % smaller at camera 0 (its top under half a pixel lower; 2.2 % at most). The push is
+// whole on the player's row and fades out over one row north and south (none a row away or more): a follower behind
+// the player stays behind, one in front stays in front, and when they cross the order changes once.
+void Follower_DrawPos(FieldActor *actor, VecFx32 *pos);
+
 #endif // POKEBW2_FOLLOWER_H
