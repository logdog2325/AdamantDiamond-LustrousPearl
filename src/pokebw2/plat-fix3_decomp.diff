@@ -470,4 +473,69 @@ u32 Follower_SightCollCheck(FieldActor *actor, s16 x, s16 y, s16 z, u16 dir) {
     return result;
 }
 
+// Its picture behind the player on their row (follower.h Follower_DrawPos): its billboard's place goes back along the
+// line from the eye, by two steps of the Z-buffer there (z / w to 1 / 16384: a step is d * d / (2 * near * 16384) units
+// when far is much beyond near), at most PUSH_MAX, all of it on the player's row and none a row (ROW) or more north or
+// south
+#define ROW FX32_CONST(16)
+#define PUSH_MAX FX32_CONST(8)
+
+void Follower_DrawPos(FieldActor *actor, VecFx32 *pos) {
+    MMSys *mmSys;
+    FieldActor *player;
+    Field *field;
+    G3DCamera *camera;
+    VecFx32 own;
+    VecFx32 at;
+    VecFx32 eye;
+    VecFx32 ray;
+    fx32 dz;
+    fx32 near;
+    fx32 dist;
+    fx32 push;
+    fx32 k;
+
+    CopyActorPosAllAdd(actor, pos);
+    if (GetActorUID(actor) != FOLLOWER_UID || GetActorMoveCode(actor) != MOVE_CODE_FOLLOW) {
+        return;
+    }
+    mmSys = GetActorMModelSystem(actor);
+    player = FindPlayerFieldActor(mmSys);
+    field = GetMMSysField(mmSys);
+    if (player == NULL || field == NULL) {
+        return;
+    }
+    CopyActorWPos(actor, &own);
+    CopyActorWPos(player, &at);
+    dz = own.z - at.z;
+    if (dz < 0) {
+        dz = -dz;
+    }
+    if (dz >= ROW) {
+        return;
+    }
+    camera = FieldCamera_GetG3DCamera(Field_GetCameraSystem(field));
+    GFL_G3DCameraGetLookatPos(camera, &eye);
+    GFL_G3DCameraGetProjectionZNear(camera, &near);
+    if (near <= 0) {
+        near = FX32_ONE;
+    }
+    VEC_Subtract(pos, &eye, &ray);
+    dist = VEC_Mag(&ray);
+    if (dist <= 0) {
+        return;
+    }
+    // two steps: d * d / (16384 * near), as (d * (d / 1024) / 16) / near so that nothing overflows up to 2,000 units
+    push = FX_Div(FX_Mul(dist, FX_Div(dist, FX32_CONST(1024))) >> 4, near);
+    if (push > PUSH_MAX) {
+        push = PUSH_MAX;
+    }
+    push = FX_Mul(push, (ROW - dz) >> 4);       // (ROW - dz) / ROW: 1 on the player's row, 0 a row away
+    // every axis by the same k: the place stays on the line, so on its pixel
+    k = FX_Div(push, dist);
+    pos->x += FX_Mul(ray.x, k);
+    pos->y += FX_Mul(ray.y, k);
+    pos->z += FX_Mul(ray.z, k);
+}
+
 #endif
